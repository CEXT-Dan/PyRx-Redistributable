<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PyRx Embedded Environment" 
           Manufacturer="Open Source Community" 
           Version="1.0.0" 
           UpgradeCode="a7d8e9f0-1b2c-3d4e-5f6a-7b8c9d0e1f2a"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <!-- Inlines all cabinet archives into the single final output MSI installer file -->
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AutodeskDir" Name="Autodesk">
        <Directory Id="PluginsDir" Name="ApplicationPlugins">
          <Directory Id="INSTALLFOLDER" Name="pyrx_embedded.bundle">
            <Directory Id="ContentsFolder" Name="Contents">
              <Directory Id="CuixFolder" Name="CUIX" />
              <Directory Id="PythonFolder" Name="Python" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Bundle Core Assets Layout -->
    <ComponentGroup Id="ProductComponents">
      <Component Id="Comp_ManifestFile" Directory="INSTALLFOLDER" Guid="c1d2e3f4-a5b6-7c8d-9e0f-1a2b3c4d5e6f">
        <File Source="pyrx_embedded.bundle\PackageContents.xml" KeyPath="yes" />
      </Component>
      
      <Component Id="Comp_ReadmeFile" Directory="ContentsFolder" Guid="d2e3f4a5-b6c7-8d9e-0f1a-2b3c4d5e6f7a">
        <File Source="pyrx_embedded.bundle\Contents\README.txt" KeyPath="yes" />
      </Component>

      <!-- Automatically harvests directory structures via WiX v7 layout syntax specifications -->
      <Files Directory="PythonFolder" Include="pyrx_embedded.bundle\Contents\Python\**" />
      <Files Directory="CuixFolder" Include="pyrx_embedded.bundle\Contents\CUIX\**" />
    </ComponentGroup>

    <!-- Post-Install execution script map for PIP with silent switches configured -->
    <CustomAction Id="RunPipInstall" 
                  Directory="PythonFolder" 
                  ExeCommand="&quot;[PythonFolder]python.exe&quot; -m pip install cad-pyrx --upgrade --no-warn-script-location" 
                  Execute="deferred" 
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RunPipInstall" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="PyRx Embedded" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
